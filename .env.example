# ─────────────────────────────────────────────────────────────────────────────
# JAVITRI TRADING SERVICE — Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MySQL / Sequelize ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=javitri_trading
DB_USER=your_db_user
DB_PASSWORD=your_strong_db_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d
# Generate a DIFFERENT value than JWT_SECRET
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex
JWT_REFRESH_EXPIRES_IN=30d

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Use rzp_live_* keys in production (NOT test keys)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── KYC Data Encryption (AES-256-GCM) ────────────────────────────────────────
# CRITICAL: Must be a 64-character hex string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, PAN and bank data will NOT be encrypted — server will refuse to start.
KYC_ENCRYPTION_KEY=replace_with_64_char_hex

# ── Frontend ──────────────────────────────────────────────────────────────────
# Your production domain (no trailing slash)
FRONTEND_URL=https://yourdomain.com

# ── Security ──────────────────────────────────────────────────────────────────
# Strong random token for one-time admin account creation
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SIGNUP_TOKEN=replace_with_strong_random_token

# ── Performance ───────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Test Database (used only when running tests) ──────────────────────────────
TEST_DB_NAME=javitri_trading_test
